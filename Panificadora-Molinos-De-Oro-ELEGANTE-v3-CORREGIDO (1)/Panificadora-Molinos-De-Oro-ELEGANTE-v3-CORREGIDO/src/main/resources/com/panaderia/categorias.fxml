<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.panaderia.controller.CategoriaController" styleClass="root"><VBox spacing="18" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"><VBox spacing="3"><Label text="Categorías" styleClass="page-title"/><Label text="Organiza el catálogo por tipos de producto." styleClass="page-subtitle"/></VBox><HBox spacing="18" VBox.vgrow="ALWAYS"><VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS"><Label text="Categorías registradas" styleClass="card-title"/><TableView fx:id="tabla" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colId" text="ID"/><TableColumn fx:id="colNombre" text="Nombre"/><TableColumn fx:id="colDescripcion" text="Descripción"/></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy></TableView></VBox><VBox spacing="12" prefWidth="330" styleClass="card"><Label text="Nueva categoría" styleClass="card-title"/><Label text="Nombre *" styleClass="label-soft"/><TextField fx:id="txtNombre" promptText="Ej. Pan especial" styleClass="text-field"/><Label text="Descripción" styleClass="label-soft"/><TextArea fx:id="txtDescripcion" prefRowCount="5" wrapText="true" styleClass="text-field"/><HBox spacing="8"><Button text="Nuevo" onAction="#nuevo" styleClass="secondary"/><Button text="Guardar" onAction="#guardar" styleClass="primary"/><Button text="Eliminar" onAction="#eliminar" styleClass="danger"/></HBox><Region VBox.vgrow="ALWAYS"/><Label text="No se puede eliminar una categoría que tenga productos asociados." styleClass="label-soft" wrapText="true"/></VBox></HBox></VBox></AnchorPane>
