<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" styleClass="scroll-pane" fx:controller="com.panaderia.controller.PedidoController"><content><VBox spacing="18" style="-fx-padding:2 4 25 4;"><VBox spacing="3"><Label text="Pedidos de pasteles" styleClass="page-title"/><Label text="Registra pedidos, consulta entregas y controla su avance." styleClass="page-subtitle"/></VBox><HBox spacing="18"><VBox spacing="11" prefWidth="410" styleClass="card"><Label text="Nuevo pedido" styleClass="card-title"/><Label text="Cliente *" styleClass="label-soft"/><TextField fx:id="txtCliente" promptText="Nombre del cliente" styleClass="text-field"/><Label text="Teléfono *" styleClass="label-soft"/><TextField fx:id="txtTelefono" promptText="0999999999" styleClass="text-field"/><Label text="Fecha de entrega *" styleClass="label-soft"/><DatePicker fx:id="dpEntrega" maxWidth="Infinity" styleClass="date-picker"/><Label text="Observaciones" styleClass="label-soft"/><TextArea fx:id="txtObs" prefRowCount="3" wrapText="true" styleClass="text-field"/><Separator/><Label text="Productos del pedido" styleClass="card-title"/><HBox spacing="7"><ComboBox fx:id="cmbProducto" HBox.hgrow="ALWAYS" promptText="Producto" styleClass="combo-box"/><TextField fx:id="txtCantidad" prefWidth="75" promptText="Cant." styleClass="text-field"/><Button text="Agregar" onAction="#agregar" styleClass="gold"/></HBox><TableView fx:id="tablaDetalle" prefHeight="170"><columns><TableColumn fx:id="colDetProducto" text="Producto"/><TableColumn fx:id="colDetCantidad" text="Cant."/><TableColumn fx:id="colDetPrecio" text="Precio"/><TableColumn fx:id="colDetSubtotal" text="Subtotal"/></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy></TableView><HBox spacing="8"><Button text="Quitar línea" onAction="#quitar" styleClass="secondary"/><Region HBox.hgrow="ALWAYS"/><Button text="Guardar pedido" onAction="#guardar" styleClass="primary"/></HBox></VBox><VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Pedidos registrados" styleClass="card-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnEstado" text="Avanzar estado" onAction="#cambiarEstado" styleClass="gold"/></HBox><HBox spacing="8"><TextField fx:id="txtBuscar" promptText="Buscar cliente o teléfono" HBox.hgrow="ALWAYS" onKeyReleased="#filtrar" styleClass="text-field"/><ComboBox fx:id="cmbEstado" prefWidth="135" onAction="#filtrar" styleClass="combo-box"/><DatePicker fx:id="dpDesde" promptText="Desde" onAction="#filtrar" styleClass="date-picker"/><DatePicker fx:id="dpHasta" promptText="Hasta" onAction="#filtrar" styleClass="date-picker"/><Button text="Limpiar" onAction="#limpiarFiltros" styleClass="secondary"/></HBox><TableView fx:id="tablaPedidos" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colId" text="#"/><TableColumn fx:id="colCliente" text="Cliente"/><TableColumn fx:id="colTelefono" text="Teléfono"/><TableColumn fx:id="colFecha" text="Entrega"/><TableColumn fx:id="colEstado" text="Estado"/></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy></TableView><Label text="Secuencia: Pendiente → En preparación → Listo → Entregado. También puede cancelarse antes de Listo." styleClass="label-soft" wrapText="true"/></VBox></HBox></VBox></content></ScrollPane>
