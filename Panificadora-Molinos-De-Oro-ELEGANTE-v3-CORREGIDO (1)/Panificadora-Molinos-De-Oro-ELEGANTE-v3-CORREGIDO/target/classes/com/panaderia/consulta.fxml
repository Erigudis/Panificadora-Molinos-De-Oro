<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.panaderia.controller.ConsultaController" styleClass="root"><VBox spacing="18" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"><VBox spacing="3"><Label text="Consulta rápida de stock" styleClass="page-title"/><Label text="Una vista sencilla para atender al cliente y conocer disponibilidad al instante." styleClass="page-subtitle"/></VBox><HBox spacing="12" styleClass="card"><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Producto" styleClass="label-soft"/><TextField fx:id="txtBuscar" promptText="Busca por nombre..." onKeyReleased="#filtrar" styleClass="text-field"/></VBox><VBox spacing="5"><Label text="Categoría" styleClass="label-soft"/><ComboBox fx:id="cmbCategoria" prefWidth="140" onAction="#filtrar" styleClass="combo-box"/></VBox><VBox spacing="5"><Label text="Disponibilidad" styleClass="label-soft"/><ComboBox fx:id="cmbEstado" prefWidth="140" onAction="#filtrar" styleClass="combo-box"/></VBox><Button text="Limpiar filtros" onAction="#limpiar" styleClass="secondary"/></HBox><VBox spacing="12" styleClass="card" VBox.vgrow="ALWAYS"><HBox alignment="CENTER_LEFT"><Label text="Disponibilidad actual" styleClass="card-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Stock bajo = necesita producción" style="-fx-text-fill:#b73a32;-fx-font-weight:bold;"/></HBox><TableView fx:id="tabla" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colProducto" text="Producto"/><TableColumn fx:id="colCategoria" text="Categoría"/><TableColumn fx:id="colStock" text="Stock"/><TableColumn fx:id="colPrecio" text="Precio"/></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy></TableView></VBox></VBox></AnchorPane>
