<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" styleClass="scroll-pane" fx:controller="com.panaderia.controller.ProductoController">
 <content><VBox spacing="18" style="-fx-padding:2 4 25 4;">
  <VBox spacing="3"><Label text="Catálogo de productos" styleClass="page-title"/><Label text="Administra precios, existencias y categorías desde una vista clara." styleClass="page-subtitle"/></VBox>
  <HBox spacing="12" styleClass="card" alignment="CENTER_LEFT"><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Buscar producto" styleClass="label-soft"/><TextField fx:id="txtBuscar" promptText="Escribe el nombre..." onKeyReleased="#filtrar" styleClass="text-field"/></VBox><VBox spacing="5"><Label text="Categoría" styleClass="label-soft"/><ComboBox fx:id="cmbFiltro" prefWidth="145" onAction="#filtrar" styleClass="combo-box"/></VBox><VBox spacing="5"><Label text="Disponibilidad" styleClass="label-soft"/><ComboBox fx:id="cmbEstado" prefWidth="145" onAction="#filtrar" styleClass="combo-box"/></VBox><Button text="Limpiar filtros" onAction="#limpiarFiltros" styleClass="secondary"/></HBox>
  <SplitPane dividerPositions="0.62" prefHeight="500">
   <items><VBox spacing="10" styleClass="card"><HBox alignment="CENTER_LEFT"><Label text="Productos registrados" styleClass="card-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Selecciona una fila para editar" styleClass="label-soft"/></HBox><TableView fx:id="tabla" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colId" text="ID"/><TableColumn fx:id="colNombre" text="Producto"/><TableColumn fx:id="colCategoria" text="Categoría"/><TableColumn fx:id="colPrecio" text="Precio"/><TableColumn fx:id="colStock" text="Stock"/><TableColumn fx:id="colDescripcion" text="Descripción"/></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy></TableView></VBox>
   <VBox spacing="13" styleClass="card"><Label text="Ficha del producto" styleClass="card-title"/><Label text="Los campos marcados con * son obligatorios" styleClass="label-soft"/>
    <GridPane hgap="10" vgap="10"><columnConstraints><ColumnConstraints minWidth="105"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
     <Label text="Nombre *" GridPane.rowIndex="0"/><TextField fx:id="txtNombre" promptText="Ej. Pan francés" styleClass="text-field" GridPane.columnIndex="1"/>
     <Label text="Categoría *" GridPane.rowIndex="1"/><ComboBox fx:id="cmbCategoria" maxWidth="Infinity" promptText="Selecciona" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
     <Label text="Precio *" GridPane.rowIndex="2"/><TextField fx:id="txtPrecio" promptText="0.00" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
     <Label text="Stock *" GridPane.rowIndex="3"/><TextField fx:id="txtStock" promptText="0" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
     <Label text="Stock mínimo" GridPane.rowIndex="4"/><TextField fx:id="txtMinimo" promptText="10" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
     <Label text="Descripción" GridPane.rowIndex="5"/><TextArea fx:id="txtDescripcion" prefRowCount="3" wrapText="true" promptText="Descripción opcional" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    <HBox spacing="8"><Button text="Nuevo" onAction="#nuevo" styleClass="secondary"/><Button fx:id="btnGuardar" text="Guardar cambios" onAction="#guardar" styleClass="primary"/><Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="danger"/></HBox>
    <Separator/><Label text="Ajuste rápido de stock" styleClass="card-title"/><HBox spacing="8"><TextField fx:id="txtCantidad" prefWidth="100" promptText="Cantidad" styleClass="text-field"/><Button fx:id="btnEntrada" text="+ Entrada" onAction="#entrada" styleClass="success"/><Button fx:id="btnSalida" text="− Salida" onAction="#salida" styleClass="warning"/></HBox>
   </VBox></items>
  </SplitPane>
 </VBox></content>
</ScrollPane>
